{% extends "base.html" %}
{% from "icon_macro.html" import icon %}
{% block content %}

<!-- ═══ 品牌主视觉 ═══ -->
<section class="hero hero-nebula">
  <div class="hero-badge">DIGITAL ECOSYSTEM · 数字生态</div>
  <h1 class="hero-title">数字<em>生态</em>家园</h1>
  <p class="hero-sub">一个账号，连接所有产品 —— 让科技温暖每个家庭</p>
  <div class="hero-tags">
    <span>{{ icon("globe") }} ecojia.cn</span><span>{{ icon("link") }} 统一账号体系</span><span>{{ icon("users") }} 全民共创</span>
  </div>
  <div class="hero-cta">
    <a class="btn btn-gold btn-lg" href="#main-product">{{ icon("rocket") }} 进入主打产品</a>
    <a class="btn btn-ghost btn-lg" href="/tools">{{ icon("grid") }} 工具清单</a>
    <a class="btn btn-ghost btn-lg" href="/wishes">{{ icon("sparkles") }} 我要许愿</a>
  </div>
</section>

<!-- ═══ 当前主打区 ═══ -->
<section class="main-product" id="main-product">
  <div class="mp-card">
    <div class="mp-head">
      <span class="mp-badge">当前主打 · {{ main_product.status }}</span>
      <span class="mp-icon">{{ icon(picon(main_product.icon), "ic-neon") }}</span>
    </div>
    <h2 class="mp-name">{{ main_product.name }}</h2>
    <p class="mp-scope">全民共创式资料共享与智能查询平台</p>
    <p class="mp-desc">查资料 · 传资料 · 赚积分 · AI智能帮您找。<br>
    出院记录、诊断证明、各类单据……大家上传、大家共享、大家受益。</p>
    <div class="mp-feats">
      <span>{{ icon("search") }} AI智能搜索</span><span>{{ icon("users") }} 社区共创</span><span>{{ icon("trophy") }} 贡献等级</span><span>{{ icon("gem") }} VIP权益</span>
    </div>
    <a class="btn btn-gold btn-lg mp-btn" href="{{ main_url }}" target="_blank">立即进入 {{ icon("arrowright") }}</a>
  </div>
</section>

<!-- ═══ 产品矩阵 ═══ -->
<section class="section" id="products">
  <div class="sec-head">
    <h2>产品矩阵</h2>
    <p>{{ products|length }}位数字成员，覆盖生活的每个角落（点击卡片可许愿催更）</p>
  </div>
  <div class="product-grid">
    {% for p in products %}
    <a class="p-card {{ 'p-main' if p.main else '' }}" href="{{ p.url or '/wishes?product=' ~ p.name }}"
       {% if p.url %}target="_blank"{% endif %}>
      <div class="p-top">
        <span class="p-no">{{ p.no }}</span>
        <span class="p-status s-{{ {'已上线':'live','规划中':'plan','敬请期待':'soon','虚位以待':'open'}[p.status] }}">{{ p.status }}</span>
      </div>
      <div class="p-icon">{{ icon(picon(p.icon), "ic-neon") }}</div>
      <h3 class="p-name">{{ p.name }}</h3>
      {% if p.en %}<div class="p-en">{{ p.en }}</div>{% endif %}
      <p class="p-scope">{{ p.scope }}</p>
      <p class="p-desc">{{ p.desc }}</p>
      <span class="p-go">{{ p.url and '进入' or '许愿催更' }} {{ icon("chevronright") }}</span>
    </a>
    {% endfor %}
  </div>
</section>

<!-- ═══ 硬件探讨区 ═══ -->
<section class="section" id="hardware">
  <div class="sec-head">
    <h2>硬件探讨区</h2>
    <p>软件之外，我们也在关注这些改变生活的硬件方向</p>
  </div>
  <div class="hw-grid">
    {% for h in hardware %}
    <div class="hw-card">
      <span class="hw-icon">{{ icon(picon(h.icon), "ic-neon") }}</span>
      <div>
        <h4>{{ h.name }}</h4>
        <p>{{ h.desc }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<!-- ═══ 开放接口说明（积木底座） ═══ -->
<section class="section open-api">
  <div class="sec-head">
    <h2>开放生态</h2>
    <p>本站作为生态积木底座，公开接口如下（全量清单见 /api/ecosystem/manifest）</p>
  </div>
  <div class="api-cards">
    {% for a in apis if a.auth == '公开' and a.method == 'GET' %}
    <div class="api-card"><code>{{ a.method }} {{ a.path }}</code><p>{{ a.desc }}</p></div>
    {% endfor %}
  </div>
</section>

{% endblock %}
